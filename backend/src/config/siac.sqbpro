olumns/><plot_y_axes/><global_filter/></table><table schema="main" name="work_orders" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="66"/><column index="2" value="58"/><column index="3" value="57"/><column index="4" value="66"/><column index="5" value="101"/><column index="6" value="101"/><column index="7" value="104"/><column index="8" value="58"/><column index="9" value="61"/><column index="10" value="60"/><column index="11" value="187"/><column index="12" value="79"/><column index="13" value="81"/><column index="14" value="126"/><column index="15" value="127"/><column index="16" value="99"/><column index="17" value="184"/><column index="18" value="118"/><column index="19" value="104"/><column index="20" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE technicians_new (
    id_tech INTEGER PRIMARY KEY AUTOINCREMENT,
	name_tech	TEXT NOT NULL,
	contact_number_tech	TEXT,
	id_area	TEXT,
	id_user	TEXT,
	FOREIGN KEY(id_user) REFERENCES users(id_user),
	FOREIGN KEY(id_area) REFERENCES areas(id_area)
);
	
INSERT INTO technicians_new (code_tech, name_tech, contact_number_tech, id_area, id_user)
SELECT id_tech, name_tech, contact_number_tech, id_area, id_user
FROM technicians;

CREATE TABLE technicians_map AS
SELECT old.id_tech AS old_id, new.id_tech AS new_id
FROM technicians AS old
JOIN technicians_new AS new ON old.code_tech = new.code_tech;


UPDATE work_order_technicians
SET id_tech = (
    SELECT new_id FROM technicians_map WHERE technicians_map.old_id = work_order_technicians.id_tech
);

UPDATE work_orders
SET id_tech = (
    SELECT new_id FROM technicians_map WHERE technicians_map.old_id = work_orders.id_tech
);

PRAGMA foreign_keys = ON;



SELECT id_area, code_area, name_area FROM areas;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
