{
  "name": "simac-electron",
  "version": "1.0.0",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && nodemon server.js",
    "dev:frontend": "cd SIMAC && npm run dev",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:electron\"",
    "build:frontend": "cd SIMAC && vite build",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^26.0.0"
  },
  "build": {
    "appId": "com.simac.electron",
    "productName": "SIMAC",
    "directories": {
      "output": "dist_electron",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "SIMAC/dist/**/*",
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/src/config/siac.sqlite",
        "to": "siac.sqlite"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "wait-on": "^9.0.1"
  }
}
